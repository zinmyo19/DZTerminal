<?xml version="1.0" encoding="utf-8"?>
<!-- v1.0.40: header bar removed (BACK/filename/RUN/SAVE gone — actions
     live in the floating ⋮ menu, same pattern as the Console). The
     editor fills the freed space; the ⋮ button floats top-right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/editor_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top|start"
        android:padding="12dp"
        android:background="@color/dz_console_bg"
        android:textColor="@color/dz_white"
        android:textSize="14sp"
        android:typeface="monospace"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/editor_menu_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:text="⋮"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#BFFFFFFF"
        android:background="@drawable/menu_fab_bg"
        android:alpha="0.55"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:focusable="false"
        android:focusableInTouchMode="false" />
</FrameLayout>
