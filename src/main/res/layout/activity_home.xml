<?xml version="1.0" encoding="utf-8"?>
<!-- v1.0.49: TEN wide shield cards (2 x 5): the original four
     (Console, Editor, Programs, QPYPI) plus Quick Run, Snippets,
     Clone Repo, Pkg Manager, Backup, QR Script — per the
     approved 10-card mockup. Construction is unchanged from
     v1.0.44: the gear row is the root's LAST child (pinned to
     the window bottom by construction), the middle column is
     0dp + weight 1 and absorbs all size error, and
     MainActivity.fitHomeToScreen() scales the flexible block
     (big shield 200x220 + 5 card rows of 158x80, 12dp gap,
     4dp row margins) to the middle column's measured height,
     clamped 0.62..1.0, floor-rounded. Wide cards use the new
     @drawable/shield_card_wide family (200x96 viewport shield).
     Card glyph 20sp / label 14sp so the pair fits the 80dp
     design height even at the Oppo's ~0.73 scale (~58dp). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/steel_bg">

    <!-- Banner header: centered framed title, no 3-dot menu -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/steel_header"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/banner_plate"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/dz_white" />
    </LinearLayout>

    <!-- Weighted middle column: absorbs all leftover/shortfall;
         its children are runtime-scaled to fit (fitHomeToScreen). -->
    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <!-- Big center shield logo button: FIXED 200x220dp,
             selector src (pressed/focused = green glow). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp">

            <ImageView
                android:id="@+id/home_terminal_button"
                android:layout_width="200dp"
                android:layout_height="220dp"
                android:src="@drawable/home_shield_selector"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                android:contentDescription="@string/card_console" />
        </LinearLayout>

        <!-- v1.0.52: weighted spacers (this one + one after each
             card row) share out any leftover height evenly, so
             on tall screens the stack fills the column instead
             of pooling one big gap above the gear. They are NOT
             in fitHomeToScreen's math: the scaler guarantees
             shield+rows+fixed <= column height, and when space
             is tight the spacers collapse to 0 and the rows'
             own 4dp margins remain the minimum gaps. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Card row 1: Sessions / Editor -->
        <LinearLayout
            android:id="@+id/home_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/card_sessions"
                android:layout_width="158dp"
                android:layout_height="80dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card_wide">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▤"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_sessions"
                    android:textSize="14sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_editor"
                android:layout_width="158dp"
                android:layout_height="80dp"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card_wide">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✎"
                    android:textSize="20sp"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_editor"
                    android:textSize="14sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Card row 2: Programs / QPYPI -->
        <LinearLayout
            android:id="@+id/home_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/card_programs"
                android:layout_width="158dp"
                android:layout_height="80dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card_wide">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;/&gt;"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_programs"
                    android:textSize="14sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_qpypi"
                android:layout_width="158dp"
                android:layout_height="80dp"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card_wide">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▦"
                    android:textSize="20sp"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_qpypi"
                    android:textSize="14sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Card row 3: Quick Run / Snippets (new in v1.0.49) -->
        <LinearLayout
            android:id="@+id/home_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/card_quickrun"
                android:layout_width="158dp"
                android:layout_height="80dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card_wide">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textSize="20sp"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_quick_run"
                    android:textSize="14sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_snippets"
                android:layout_width="158dp"
                android:layout_height="80dp"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card_wide">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☰"
                    android:textSize="20sp"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_snippets"
                    android:textSize="14sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Card row 4: Clone Repo / Pkg Manager (batch 2 —
             cards visible now, screens land in the next build) -->
        <LinearLayout
            android:id="@+id/home_row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/card_clone"
                android:layout_width="158dp"
                android:layout_height="80dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card_wide">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↓"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_clone_repo"
                    android:textSize="14sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_pkg"
                android:layout_width="158dp"
                android:layout_height="80dp"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card_wide">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▣"
                    android:textSize="20sp"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_pkg_manager"
                    android:textSize="14sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Card row 5: Backup / QR Script (QR is batch 3) -->
        <LinearLayout
            android:id="@+id/home_row5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="0dp">

            <LinearLayout
                android:id="@+id/card_backup"
                android:layout_width="158dp"
                android:layout_height="80dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card_wide">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↻"
                    android:textSize="20sp"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_backup"
                    android:textSize="14sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_qr"
                android:layout_width="158dp"
                android:layout_height="80dp"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card_wide">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▩"
                    android:textSize="20sp"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_qr_script"
                    android:textSize="14sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Gear row: the root's LAST child — pinned to the window
         bottom by construction (the middle column above it is
         weighted), so it can never be pushed off-screen. -->
    <LinearLayout
        android:id="@+id/home_gear_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/home_gear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/gear_button_bg"
            android:gravity="center"
            android:text="&#x2699;&#xFE0E;"
            android:textSize="26sp"
            android:textColor="@color/dz_green"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menu" />
    </LinearLayout>
</LinearLayout>
