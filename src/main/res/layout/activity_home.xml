<?xml version="1.0" encoding="utf-8"?>
<!-- v1.0.36: tightened further (user: push up again).
     v1.0.35: tighten-up — everything moves UP, gear fully visible.
     v1.0.34's gear was half-clipped at the bottom edge and the
     banner sat too low. Tightened: header padding 10 -> 4dp,
     banner plate padding 8 -> 6dp, banner text 22 -> 20sp,
     content top padding 6 -> 0dp, content bottom 6 -> 10dp,
     shield margins 4/8 -> 0/4dp, card row gaps 10 -> 6dp,
     gear row marginTop 2 -> 6dp + marginBottom 10dp (the gear
     never sits flush with the screen edge again).
     Shield stays 200x236, cards stay 140x168. Total ~710dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/steel_bg">

    <!-- Banner header: centered framed title, no 3-dot menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/steel_header"
        android:padding="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/banner_plate"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/dz_white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="0dp"
        android:paddingBottom="6dp">

        <!-- Big center shield logo button: FIXED 200x236dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="2dp">

            <ImageView
                android:id="@+id/home_terminal_button"
                android:layout_width="200dp"
                android:layout_height="236dp"
                android:src="@drawable/home_shield"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                android:contentDescription="@string/card_console" />
        </LinearLayout>

        <!-- Shield card row 1: FIXED 140x168dp cards, 16dp gap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/card_console"
                android:layout_width="140dp"
                android:layout_height="168dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terminal_glyph"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/card_console"
                    android:textSize="16sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_editor"
                android:layout_width="140dp"
                android:layout_height="168dp"
                android:layout_marginStart="16dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✎"
                    android:textSize="24sp"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/card_editor"
                    android:textSize="16sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shield card row 2: FIXED 140x168dp cards, 16dp gap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/card_programs"
                android:layout_width="140dp"
                android:layout_height="168dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;/&gt;"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/card_programs"
                    android:textSize="16sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_qpypi"
                android:layout_width="140dp"
                android:layout_height="168dp"
                android:layout_marginStart="16dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▦"
                    android:textSize="24sp"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/card_qpypi"
                    android:textSize="16sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Gear menu button: CENTERED below the bottom shields.
             Opens the same menu the 3-dot had. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/home_gear"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/gear_button_bg"
                android:gravity="center"
                android:text="&#x2699;&#xFE0E;"
                android:textSize="26sp"
                android:textColor="@color/dz_green"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Menu" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
