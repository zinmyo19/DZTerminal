<?xml version="1.0" encoding="utf-8"?>
<!-- v1.0.32: compact fixed-size shield Home — fits ONE screen, NO scroll.
     FIX (v1.0.31 bugs): v1.0.31 used a ScrollView + oversized fixed
     sizes (220x260dp button, 170dp cards, 20dp paddings) totalling
     ~782dp on a ~760dp-usable screen (POCO F5 Pro 1080x2400,
     360x800dp), so the bottom row was clipped and the screen
     scrolled. This layout uses FIXED COMPACT dp sizes totalling
     ~695dp: header ~75 + content padding 20 + button 228 +
     card rows 372 = 695dp <= 760dp usable. No ScrollView, so
     scrolling is impossible. Card size 150x180dp matches the
     shield vector aspect (100:120) so the shield is not distorted.
     Background: @drawable/steel_bg (seamless mirrored tile). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/steel_bg">

    <!-- Brushed-steel header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/steel_header"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/dz_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_subtitle"
                android:textSize="14sp"
                android:textColor="@color/dz_muted" />
        </LinearLayout>

        <Button
            android:id="@+id/home_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:text="@string/menu"
            android:textSize="24sp"
            android:textColor="@color/dz_muted"
            android:background="@android:color/transparent" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Big center shield logo button: FIXED 180x212dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/home_terminal_button"
                android:layout_width="180dp"
                android:layout_height="212dp"
                android:src="@drawable/home_shield"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                android:contentDescription="@string/card_console" />
        </LinearLayout>

        <!-- Shield card row 1: FIXED 150x180dp cards, 16dp gap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/card_console"
                android:layout_width="150dp"
                android:layout_height="180dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terminal_glyph"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/card_console"
                    android:textSize="16sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_editor"
                android:layout_width="150dp"
                android:layout_height="180dp"
                android:layout_marginStart="16dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✎"
                    android:textSize="24sp"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/card_editor"
                    android:textSize="16sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shield card row 2: FIXED 150x180dp cards, 16dp gap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/card_programs"
                android:layout_width="150dp"
                android:layout_height="180dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;/&gt;"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/card_programs"
                    android:textSize="16sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_qpypi"
                android:layout_width="150dp"
                android:layout_height="180dp"
                android:layout_marginStart="16dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shield_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▦"
                    android:textSize="24sp"
                    android:textColor="@color/dz_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/card_qpypi"
                    android:textSize="16sp"
                    android:textColor="@color/dz_white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
