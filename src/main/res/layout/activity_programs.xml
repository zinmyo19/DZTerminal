<?xml version="1.0" encoding="utf-8"?>
<!-- v1.0.40: header bar removed (BACK/title/UP/IMPORT/NEW gone — actions
     live in the floating ⋮ menu, same pattern as the Console; the
     current folder name shows as a disabled header item inside the
     menu). Content fills the freed space. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/steel_bg">

        <!-- Mode strip (v1.0.10): Home files <-> QPython scripts. The
             Choose-folder button only shows in QPython mode. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/programs_qpython"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qpython_scripts"
                android:textColor="@color/dz_green"
                android:background="@android:color/transparent" />

            <Button
                android:id="@+id/programs_choose_qpython"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_folder"
                android:textColor="@color/dz_green"
                android:background="@android:color/transparent"
                android:visibility="gone" />
        </LinearLayout>

        <ListView
            android:id="@+id/programs_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <Button
        android:id="@+id/programs_menu_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:text="⋮"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#BFFFFFFF"
        android:background="@drawable/menu_fab_bg"
        android:alpha="0.55"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:focusable="false"
        android:focusableInTouchMode="false" />
</FrameLayout>
